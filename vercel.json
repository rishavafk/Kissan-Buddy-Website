{
    "version": 2,
    "builds": [
        {
            "src": "api/auth/*.ts",
            "use": "@vercel/node"
        },
        {
            "src": "api/health.ts",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/public"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/auth/(.*)",
            "destination": "/api/auth/$1"
        },
        {
            "source": "/api/health",
            "destination": "/api/health"
        },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.ts"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}