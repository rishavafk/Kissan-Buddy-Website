{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.ts",
            "use": "@vercel/node"
        },
        {
            "src": "package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist/public"
            }
        }
    ],
    "routes": [
        {
            "src": "/api/auth/login",
            "dest": "/api/auth/login.ts"
        },
        {
            "src": "/api/auth/signup",
            "dest": "/api/auth/signup.ts"
        },
        {
            "src": "/api/auth/me",
            "dest": "/api/auth/me.ts"
        },
        {
            "src": "/api/health",
            "dest": "/api/health.ts"
        },
        {
            "src": "/api/(.*)",
            "dest": "/api/index.ts"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}