# Server Configuration
PORT=5001

# Authentication (Required)
# Generate a secure random string for signing session tokens
SESSION_SECRET=your-secure-random-secret-key-here

# Database Configuration (Optional - Falls back to memory if missing)
# For production persistence, use Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# Other Keys
API_KEY=your_api_key_here